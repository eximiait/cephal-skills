#!/bin/sh
# cephal-version: calcula, valida y escribe versiones y tags de despliegue.
# Diseño: docs/superpowers/specs/2026-10-05-cephal-versioning-skills-design.md
set -u

die() {
  printf 'ERR: %s\n' "$*" >&2
  exit 1
}

kv() {
  printf '%s=%s\n' "$1" "$2"
}

# Valor de una variable del bloque `variables:` de primer nivel del .gitlab-ci.yml raíz.
ci_var() {
  [ -f .gitlab-ci.yml ] || return 0
  awk -v key="$1" '
    /^variables:[[:space:]]*(#.*)?$/ { inv = 1; next }
    /^[^[:space:]#]/ { inv = 0 }
    inv && $0 ~ ("^[[:space:]]+" key ":") {
      v = $0
      sub("^[[:space:]]+" key ":[[:space:]]*", "", v)
      sub(/[[:space:]]+#.*$/, "", v)
      sub(/[[:space:]]+$/, "", v)
      f = substr(v, 1, 1)
      if ((f == "\"" || f == sprintf("%c", 39)) && substr(v, length(v), 1) == f) v = substr(v, 2, length(v) - 2)
      print v
      exit
    }
  ' .gitlab-ci.yml
}

develop_branch() {
  v=$(ci_var DEVELOP_BRANCH)
  printf '%s\n' "${v:-develop}"
}

chart_dir() {
  v=$(ci_var HELM_BASEDIR)
  printf '%s\n' "${v:-chart}"
}

# Lenguaje del proyecto: maven|gradle|npm|pnpm. Nota: `die` dentro de $(...) solo sale del subshell;
# quien la invoque así debe propagar el código de salida.
detect_lang() {
  if [ -n "${LANG_OVERRIDE:-}" ]; then
    case "$LANG_OVERRIDE" in
      maven | gradle | npm | pnpm)
        printf '%s\n' "$LANG_OVERRIDE"
        return 0
        ;;
      *) die "lenguaje no soportado: $LANG_OVERRIDE" ;;
    esac
  fi
  found=""
  n=0
  if [ -f pom.xml ]; then
    found=maven
    n=$((n + 1))
  fi
  if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    found=gradle
    n=$((n + 1))
  fi
  if [ -f package.json ]; then
    if [ -f pnpm-lock.yaml ]; then found=pnpm; else found=npm; fi
    n=$((n + 1))
  fi
  [ "$n" -ge 1 ] || die "lenguaje no detectado"
  [ "$n" -eq 1 ] || die "más de un lenguaje, usá --lang"
  printf '%s\n' "$found"
}

# Reescribe $1 con la salida del comando que sigue (que debe leer el archivo); si falla, no toca nada.
rewrite() {
  rw_file=$1
  shift
  rw_tmp="$rw_file.cephal.$$"
  if "$@" "$rw_file" >"$rw_tmp"; then
    mv "$rw_tmp" "$rw_file"
  else
    rm -f "$rw_tmp"
    return 1
  fi
}

# Maven. $1 = etiqueta objetivo ("version" o el nombre de una propiedad); $2 = modo (get|set); $3 = nueva versión.
# Con get imprime el valor; con set imprime el archivo reescrito. Sale con 3 si no encuentra la etiqueta.
maven_tag() {
  awk -v BINMODE=3 -v tag="$1" -v mode="$2" -v nv="${3:-}" '
    BEGIN { re = "<" tag ">[^<]*</" tag ">"; n = length(tag) }
    {
      l = $0
      if (l ~ /<parent>/) inparent = 1
      if (tag == "version") { if (l ~ /<(dependencies|dependencyManagement|build|profiles|reporting)>/) stop = 1 }
      else if (l ~ /<profiles>/) stop = 1
      if (l ~ /<properties>/) inprops = 1
      if (!done && !stop && !inparent && (tag == "version" || inprops) && match(l, re)) {
        cur = substr(l, RSTART + n + 2, RLENGTH - 2 * n - 5)
        done = 1
        if (mode == "set") l = substr(l, 1, RSTART + n + 1) nv substr(l, RSTART + RLENGTH - n - 3)
      }
      if (l ~ /<\/parent>/) inparent = 0
      if (l ~ /<\/properties>/) inprops = 0
      out = out l ORS
    }
    END {
      if (!done) exit 3
      if (mode == "set") printf "%s", out; else print cur
    }
  ' pom.xml
}

# Adaptador para `rewrite`, que agrega el archivo como último argumento (maven_tag ya lee pom.xml).
maven_tag_file() {
  maven_tag "$1" "$2" "$3"
}

# Etiqueta de pom.xml que contiene la versión: "version", o la propiedad si es del tipo ${nombre}.
maven_target() {
  mt_v=$(maven_tag version get) || return 1
  case "$mt_v" in
    '${'*'}')
      mt_v=${mt_v#'${'}
      printf '%s\n' "${mt_v%'}'}"
      ;;
    *) printf 'version\n' ;;
  esac
}

# Gradle: archivo que define `version` (gradle.properties primero). $1 = modo; $2 = nueva versión.
gradle_file() {
  for gf in gradle.properties build.gradle.kts build.gradle; do
    if [ -f "$gf" ] && grep -Eq '^version[[:space:]]*=' "$gf"; then
      printf '%s\n' "$gf"
      return 0
    fi
  done
  return 1
}

gradle_version() {
  awk -v BINMODE=3 -v mode="$1" -v nv="${2:-}" '
    /^version[[:space:]]*=/ && !done {
      l = $0
      eq = index(l, "=")
      head = substr(l, 1, eq)
      rhs = substr(l, eq + 1)
      cr = (rhs ~ /\r$/) ? "\r" : ""
      sub(/\r$/, "", rhs)
      lead = rhs
      sub(/[^[:space:]].*$/, "", lead)
      body = rhs
      sub(/^[[:space:]]+/, "", body)
      sub(/[[:space:]]+$/, "", body)
      q = ""
      c = substr(body, 1, 1)
      if ((c == "\"" || c == sprintf("%c", 39)) && substr(body, length(body), 1) == c) {
        q = c
        body = substr(body, 2, length(body) - 2)
      }
      cur = body
      done = 1
      if (mode == "set") $0 = head lead q nv q cr
    }
    { out = out $0 ORS }
    END { if (mode == "set") printf "%s", out; else print cur }
  ' "$3"
}

# npm/pnpm: campo "version" de primer nivel de package.json. $1 = modo; $2 = nueva versión.
npm_version() {
  awk -v BINMODE=3 -v mode="$1" -v nv="${2:-}" '
    {
      l = $0
      t = l
      gsub(/"([^"\\]|\\.)*"/, "\"\"", t)
      if (!done && depth == 1 && l ~ /^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"[^"]*"/) {
        match(l, /"version"[[:space:]]*:[[:space:]]*"[^"]*"/)
        seg = substr(l, RSTART, RLENGTH)
        colon = index(seg, ":")
        val = substr(seg, colon + 1)
        ws = val
        sub(/"[^"]*"$/, "", ws)
        sub(/^[[:space:]]*"/, "", val)
        sub(/"$/, "", val)
        cur = val
        done = 1
        if (mode == "set") l = substr(l, 1, RSTART - 1) substr(seg, 1, colon) ws "\"" nv "\"" substr(l, RSTART + RLENGTH)
      }
      depth += gsub(/\{/, "{", t) - gsub(/\}/, "}", t)
      out = out l ORS
    }
    END { if (mode == "set") printf "%s", out; else print cur }
  ' "$3"
}

# Versión actual de la app (lectura estática del archivo del lenguaje).
get_version() {
  gv_lang=$(detect_lang) || exit 1
  gv=""
  case "$gv_lang" in
    maven)
      gv_tag=$(maven_target) || die "versión no resoluble, definila a mano (pom.xml)"
      gv=$(maven_tag "$gv_tag" get) || die "versión no resoluble, definila a mano (pom.xml)"
      ;;
    gradle)
      gv_f=$(gradle_file) || die "versión no resoluble, definila a mano (version en gradle.properties o build.gradle)"
      gv=$(gradle_version get "" "$gv_f")
      ;;
    npm | pnpm) gv=$(npm_version get "" package.json) ;;
  esac
  case "$gv" in
    '' | *[!0-9A-Za-z.+_-]* | [!0-9A-Za-z]*) die "versión no resoluble, definila a mano ($gv_lang)" ;;
  esac
  printf '%s\n' "$gv"
}

set_version() {
  sv_lang=$(detect_lang) || exit 1
  case "$sv_lang" in
    maven)
      sv_tag=$(maven_target) || die "versión no resoluble, definila a mano (pom.xml)"
      rewrite pom.xml maven_tag_file "$sv_tag" set "$1" || die "no se pudo escribir la versión en pom.xml"
      ;;
    gradle)
      sv_f=$(gradle_file) || die "versión no resoluble, definila a mano (version en gradle.properties o build.gradle)"
      rewrite "$sv_f" gradle_version set "$1" || die "no se pudo escribir la versión en $sv_f"
      ;;
    npm | pnpm) rewrite package.json npm_version set "$1" || die "no se pudo escribir la versión en package.json" ;;
  esac
}

# Alinea appVersion de Chart.yaml (comillas dobles). Sin Chart.yaml: informa `chart=skipped`.
set_chart_app_version() {
  sc_file="$(chart_dir)/Chart.yaml"
  if [ ! -f "$sc_file" ]; then
    kv chart skipped
    return 0
  fi
  rewrite "$sc_file" chart_app_version "$1" || die "no se pudo escribir appVersion en $sc_file"
}

chart_app_version() {
  awk -v BINMODE=3 -v nv="$1" '
    NR == 1 { cr = ($0 ~ /\r$/) ? "\r" : "" }
    /^appVersion:/ && !done { print "appVersion: \"" nv "\"" cr; done = 1; next }
    { print }
    END { if (!done) print "appVersion: \"" nv "\"" cr }
  ' "$2"
}

main() {
  LANG_OVERRIDE=""
  if [ "${1:-}" = "--lang" ]; then
    [ $# -ge 2 ] || die "falta el valor de --lang"
    LANG_OVERRIDE=$2
    shift 2
  fi
  [ $# -ge 1 ] || die "uso: cephal-version [--lang L] <context|check|bump|release-prep|next-tag|tag-push>"
  sub=$1
  shift
  fn="cmd_$(printf '%s' "$sub" | tr '-' '_')"
  if type "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  else
    die "subcomando desconocido: $sub"
  fi
}

[ "${CEPHAL_VERSION_SOURCED:-}" = 1 ] || main "$@"

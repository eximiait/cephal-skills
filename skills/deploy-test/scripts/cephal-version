#!/bin/sh
# cephal-version: calcula, valida y escribe versiones y tags de despliegue.
# Diseño: docs/superpowers/specs/2026-10-05-cephal-versioning-skills-design.md
set -u

die() {
  printf 'ERR: %s\n' "$*" >&2
  exit 1
}

kv() {
  printf '%s=%s\n' "$1" "$2"
}

# Valor de una variable del bloque `variables:` de primer nivel del .gitlab-ci.yml raíz.
ci_var() {
  [ -f .gitlab-ci.yml ] || return 0
  awk -v key="$1" '
    /^variables:[[:space:]]*(#.*)?$/ { inv = 1; next }
    /^[^[:space:]#]/ { inv = 0 }
    inv && $0 ~ ("^[[:space:]]+" key ":") {
      v = $0
      sub("^[[:space:]]+" key ":[[:space:]]*", "", v)
      sub(/[[:space:]]+#.*$/, "", v)
      sub(/[[:space:]]+$/, "", v)
      f = substr(v, 1, 1)
      if ((f == "\"" || f == sprintf("%c", 39)) && substr(v, length(v), 1) == f) v = substr(v, 2, length(v) - 2)
      print v
      exit
    }
  ' .gitlab-ci.yml
}

develop_branch() {
  v=$(ci_var DEVELOP_BRANCH)
  printf '%s\n' "${v:-develop}"
}

# Rama principal (de donde sale el deploy a prod): MAIN_BRANCH del .gitlab-ci.yml, por defecto main.
main_branch() {
  v=$(ci_var MAIN_BRANCH)
  printf '%s\n' "${v:-main}"
}

chart_dir() {
  v=$(ci_var HELM_BASEDIR)
  printf '%s\n' "${v:-chart}"
}

# Lenguaje del proyecto: maven|gradle|npm|pnpm. Nota: `die` dentro de $(...) solo sale del subshell;
# quien la invoque así debe propagar el código de salida.
detect_lang() {
  if [ -n "${LANG_OVERRIDE:-}" ]; then
    case "$LANG_OVERRIDE" in
      maven | gradle | npm | pnpm)
        printf '%s\n' "$LANG_OVERRIDE"
        return 0
        ;;
      *) die "lenguaje no soportado: $LANG_OVERRIDE" ;;
    esac
  fi
  found=""
  n=0
  if [ -f pom.xml ]; then
    found=maven
    n=$((n + 1))
  fi
  if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    found=gradle
    n=$((n + 1))
  fi
  if [ -f package.json ]; then
    if [ -f pnpm-lock.yaml ]; then found=pnpm; else found=npm; fi
    n=$((n + 1))
  fi
  [ "$n" -ge 1 ] || die "lenguaje no detectado"
  [ "$n" -eq 1 ] || die "más de un lenguaje, usá --lang"
  printf '%s\n' "$found"
}

# Reescribe $1 con la salida del comando que sigue (que debe leer el archivo); si falla, no toca nada.
rewrite() {
  rw_file=$1
  shift
  rw_tmp="$rw_file.cephal.$$"
  if "$@" "$rw_file" >"$rw_tmp"; then
    # awk termina cada línea con salto; si el original no lo tenía al final, se quita.
    if [ -s "$rw_file" ] && [ -n "$(tail -c 1 "$rw_file")" ]; then
      printf '%s' "$(cat "$rw_tmp")" >"$rw_tmp.n" && mv "$rw_tmp.n" "$rw_tmp"
    fi
    mv "$rw_tmp" "$rw_file"
  else
    rm -f "$rw_tmp"
    return 1
  fi
}

# Maven. $1 = etiqueta objetivo ("version" o el nombre de una propiedad); $2 = modo (get|set); $3 = nueva versión.
# Con get imprime el valor; con set imprime el archivo reescrito. Sale con 3 si no encuentra la etiqueta.
maven_tag() {
  awk -v BINMODE=3 -v tag="$1" -v mode="$2" -v nv="${3:-}" '
    BEGIN { re = "<" tag ">[^<]*</" tag ">"; n = length(tag) }
    {
      l = $0
      if (l ~ /<parent>/) inparent = 1
      if (tag == "version") { if (l ~ /<(dependencies|dependencyManagement|build|profiles|reporting)>/) stop = 1 }
      else if (l ~ /<profiles>/) stop = 1
      if (l ~ /<properties>/) inprops = 1
      if (!done && !stop && !inparent && (tag == "version" || inprops) && match(l, re)) {
        cur = substr(l, RSTART + n + 2, RLENGTH - 2 * n - 5)
        done = 1
        if (mode == "set") l = substr(l, 1, RSTART + n + 1) nv substr(l, RSTART + RLENGTH - n - 3)
      }
      if (l ~ /<\/parent>/) inparent = 0
      if (l ~ /<\/properties>/) inprops = 0
      out = out l ORS
    }
    END {
      if (!done) exit 3
      if (mode == "set") printf "%s", out; else print cur
    }
  ' pom.xml
}

# Adaptador para `rewrite`, que agrega el archivo como último argumento (maven_tag ya lee pom.xml).
maven_tag_file() {
  maven_tag "$1" "$2" "$3"
}

# Etiqueta de pom.xml que contiene la versión: "version", o la propiedad si es del tipo ${nombre}.
maven_target() {
  mt_v=$(maven_tag version get) || return 1
  case "$mt_v" in
    '${'*'}')
      mt_v=${mt_v#'${'}
      printf '%s\n' "${mt_v%'}'}"
      ;;
    *) printf 'version\n' ;;
  esac
}

# Gradle: archivo que define `version` (gradle.properties primero). $1 = modo; $2 = nueva versión.
gradle_file() {
  for gf in gradle.properties build.gradle.kts build.gradle; do
    if [ -f "$gf" ] && grep -Eq '^version[[:space:]]*=' "$gf"; then
      printf '%s\n' "$gf"
      return 0
    fi
  done
  return 1
}

gradle_version() {
  awk -v BINMODE=3 -v mode="$1" -v nv="${2:-}" '
    /^version[[:space:]]*=/ && !done {
      l = $0
      eq = index(l, "=")
      head = substr(l, 1, eq)
      rhs = substr(l, eq + 1)
      cr = (rhs ~ /\r$/) ? "\r" : ""
      sub(/\r$/, "", rhs)
      lead = rhs
      sub(/[^[:space:]].*$/, "", lead)
      body = rhs
      sub(/^[[:space:]]+/, "", body)
      sub(/[[:space:]]+$/, "", body)
      q = ""
      c = substr(body, 1, 1)
      if ((c == "\"" || c == sprintf("%c", 39)) && substr(body, length(body), 1) == c) {
        q = c
        body = substr(body, 2, length(body) - 2)
      }
      cur = body
      done = 1
      if (mode == "set") $0 = head lead q nv q cr
    }
    { out = out $0 ORS }
    END { if (mode == "set") printf "%s", out; else print cur }
  ' "$3"
}

# npm/pnpm: campo "version" de primer nivel de package.json. $1 = modo; $2 = nueva versión.
npm_version() {
  awk -v BINMODE=3 -v mode="$1" -v nv="${2:-}" '
    {
      l = $0
      t = l
      gsub(/"([^"\\]|\\.)*"/, "\"\"", t)
      if (!done && depth == 1 && l ~ /^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"[^"]*"/) {
        match(l, /"version"[[:space:]]*:[[:space:]]*"[^"]*"/)
        seg = substr(l, RSTART, RLENGTH)
        colon = index(seg, ":")
        val = substr(seg, colon + 1)
        ws = val
        sub(/"[^"]*"$/, "", ws)
        sub(/^[[:space:]]*"/, "", val)
        sub(/"$/, "", val)
        cur = val
        done = 1
        if (mode == "set") l = substr(l, 1, RSTART - 1) substr(seg, 1, colon) ws "\"" nv "\"" substr(l, RSTART + RLENGTH)
      }
      depth += gsub(/\{/, "{", t) - gsub(/\}/, "}", t)
      out = out l ORS
    }
    END { if (mode == "set") printf "%s", out; else print cur }
  ' "$3"
}

# Versión actual de la app (lectura estática del archivo del lenguaje).
get_version() {
  gv_lang=$(detect_lang) || exit 1
  gv=""
  case "$gv_lang" in
    maven)
      gv_tag=$(maven_target) || die "versión no resoluble, definila a mano (pom.xml)"
      gv=$(maven_tag "$gv_tag" get) || die "versión no resoluble, definila a mano (pom.xml)"
      ;;
    gradle)
      gv_f=$(gradle_file) || die "versión no resoluble, definila a mano (version en gradle.properties o build.gradle)"
      gv=$(gradle_version get "" "$gv_f")
      ;;
    npm | pnpm) gv=$(npm_version get "" package.json) ;;
  esac
  # Conjuntos explícitos: con rangos (0-9, a-z) algunos sh comparan por collation según el locale.
  case "$gv" in
    '' | *[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz.+_-]* | [!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz]*) die "versión no resoluble, definila a mano ($gv_lang)" ;;
  esac
  printf '%s\n' "$gv"
}

set_version() {
  sv_lang=$(detect_lang) || exit 1
  case "$sv_lang" in
    maven)
      sv_tag=$(maven_target) || die "versión no resoluble, definila a mano (pom.xml)"
      rewrite pom.xml maven_tag_file "$sv_tag" set "$1" || die "no se pudo escribir la versión en pom.xml"
      ;;
    gradle)
      sv_f=$(gradle_file) || die "versión no resoluble, definila a mano (version en gradle.properties o build.gradle)"
      rewrite "$sv_f" gradle_version set "$1" || die "no se pudo escribir la versión en $sv_f"
      ;;
    npm | pnpm) rewrite package.json npm_version set "$1" || die "no se pudo escribir la versión en package.json" ;;
  esac
}

# Alinea appVersion de Chart.yaml (comillas dobles). Sin Chart.yaml: informa `chart=skipped`.
set_chart_app_version() {
  sc_file="$(chart_dir)/Chart.yaml"
  if [ ! -f "$sc_file" ]; then
    kv chart skipped
    return 0
  fi
  rewrite "$sc_file" chart_app_version "$1" || die "no se pudo escribir appVersion en $sc_file"
}

chart_app_version() {
  awk -v BINMODE=3 -v nv="$1" '
    NR == 1 { cr = ($0 ~ /\r$/) ? "\r" : "" }
    /^appVersion:/ && !done { print "appVersion: \"" nv "\"" cr; done = 1; next }
    { print }
    END { if (!done) print "appVersion: \"" nv "\"" cr }
  ' "$2"
}

# Quita ceros a la izquierda ("08" → "8"): sh interpreta "08" como octal inválido en $(( )).
strip_zeros() {
  sz=${1#"${1%%[!0]*}"}
  printf '%s\n' "${sz:-0}"
}

# Retorna 0 si $1 no contiene saltos de línea (grep -E valida línea por línea).
one_line() {
  case "$1" in
    *'
'*) return 1 ;;
  esac
  return 0
}

# Lee un JSON de una línea por stdin e imprime el valor de <ruta> (`clave`, `clave.sub`,
# `0.clave` para el primer elemento de un arreglo). Solo mira las claves del nivel indicado;
# ignora el contenido de los strings. Si la ruta no existe imprime nada; un null se imprime `null`.
json_get() {
  awk -v path="$1" '
    # Lee un string desde la posición p (comilla de apertura); deja el texto en STR y p tras la comilla de cierre.
    function parse_string(   c, n) {
      STR = ""
      p++
      while (p <= len) {
        c = substr(s, p, 1)
        if (c == "\\") {
          n = substr(s, p + 1, 1)
          if (n == "\"" || n == "\\") STR = STR n
          else STR = STR c n
          p += 2
        } else if (c == "\"") {
          p++
          return
        } else {
          STR = STR c
          p++
        }
      }
    }
    BEGIN {
      nseg = split(path, seg, ".")
      s = ""
      while ((getline line) > 0) s = s line
      gsub(/[\r\n]/, "", s)
      len = length(s)
      d = 0
      p = 1
      while (p <= len) {
        c = substr(s, p, 1)
        if (c == " " || c == "\t") { p++; continue }
        if (c == "{" || c == "[") {
          d++
          typ[d] = (c == "{") ? "o" : "a"
          onp[d] = (d == 1) || (onp[d - 1] && hit[d - 1])
          expkey[d] = 1
          idx[d] = 0
          hit[d] = (typ[d] == "a" && onp[d] && ("" idx[d]) == seg[d])
          p++
        } else if (c == "}" || c == "]") {
          d--
          if (d == 0) exit
          p++
        } else if (c == ",") {
          if (typ[d] == "o") { expkey[d] = 1; hit[d] = 0 }
          else { idx[d]++; hit[d] = (onp[d] && ("" idx[d]) == seg[d]) }
          p++
        } else if (c == ":") {
          p++
        } else if (c == "\"") {
          parse_string()
          if (typ[d] == "o" && expkey[d]) {
            expkey[d] = 0
            hit[d] = (onp[d] && STR == seg[d])
          } else if (hit[d] && d == nseg) {
            print STR
            exit
          }
        } else {
          q = p
          while (q <= len) {
            c = substr(s, q, 1)
            if (c == "," || c == "}" || c == "]" || c == " " || c == "\t") break
            q++
          }
          if (hit[d] && d == nseg) {
            print substr(s, p, q - p)
            exit
          }
          p = q
        }
      }
    }
  ' </dev/stdin
}

# Sube x.y.z[-SNAPSHOT] según el tipo (patch|minor|major); conserva -SNAPSHOT.
semver_bump() {
  sb_v=$1
  sb_suffix=""
  case "$sb_v" in
    *-SNAPSHOT)
      sb_suffix=-SNAPSHOT
      sb_v=${sb_v%-SNAPSHOT}
      ;;
  esac
  if ! printf '%s\n' "$sb_v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    if printf '%s\n' "$sb_v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+-'; then
      sb_rest=${sb_v#*-}
      die "sufijo no soportado: -$sb_rest"
    fi
    die "versión no semver: $1"
  fi
  sb_maj=$(strip_zeros "${sb_v%%.*}")
  sb_rest=${sb_v#*.}
  sb_min=$(strip_zeros "${sb_rest%%.*}")
  sb_pat=$(strip_zeros "${sb_rest#*.}")
  case "$2" in
    patch) sb_pat=$((sb_pat + 1)) ;;
    minor)
      sb_min=$((sb_min + 1))
      sb_pat=0
      ;;
    major)
      sb_maj=$((sb_maj + 1))
      sb_min=0
      sb_pat=0
      ;;
    *) die "tipo inválido: $2 (patch|minor|major)" ;;
  esac
  printf '%s.%s.%s%s\n' "$sb_maj" "$sb_min" "$sb_pat" "$sb_suffix"
}

# Retorna 0 si $1 > $2 (x.y.z, comparación numérica).
semver_gt() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) {
      if (x[i] + 0 > y[i] + 0) exit 0
      if (x[i] + 0 < y[i] + 0) exit 1
    }
    exit 1
  }'
}

# Entrada: una versión x.y.z por línea. Salida: la mayor (vacío si no hay).
max_semver() {
  awk '
    function gt(a, b,   x, y, i) {
      split(a, x, "."); split(b, y, ".")
      for (i = 1; i <= 3; i++) {
        if (x[i] + 0 > y[i] + 0) return 1
        if (x[i] + 0 < y[i] + 0) return 0
      }
      return 0
    }
    NF { if (best == "" || gt($0, best)) best = $0 }
    END { if (best != "") print best }
  '
}

# Mayor tag final x.y.z, o 0.0.0 si no hay.
last_final() {
  lf=$(git tag --list | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | max_semver)
  printf '%s\n' "${lf:-0.0.0}"
}

# Mayor base con tag x.y.z-rc.n, sin tag final de esa base y mayor que el último final; vacío si no hay.
open_rc_base() {
  or_last=$(last_final)
  or_bases=""
  for or_t in $(git tag --list | grep -E '^[0-9]+\.[0-9]+\.[0-9]+-rc\.[0-9]+$'); do
    or_b=${or_t%-rc.*}
    if semver_gt "$or_b" "$or_last"; then
      or_bases="$or_bases$or_b
"
    fi
  done
  printf '%s' "$or_bases" | max_semver
}

# Mayor n entre los tags <base>-rc.n (0 si no hay).
max_rc_n() {
  mr_esc=$(printf '%s' "$1" | sed 's/\./\\./g')
  git tag --list "$1-rc.*" | grep -E "^$mr_esc-rc\.[0-9]+$" | sed 's/.*-rc\.//' |
    awk 'BEGIN { m = 0 } { if ($0 + 0 > m) m = $0 + 0 } END { print m }'
}

# next-tag <test|prod> [patch|minor|major]: imprime el tag siguiente.
cmd_next_tag() {
  nt_env=${1:-}
  nt_type=${2:-}
  case "$nt_env" in
    test | prod) ;;
    *) die "uso: next-tag <test|prod> [patch|minor|major]" ;;
  esac
  # La regla de rama depende solo del entorno: prod = tag final, test = RC.
  if [ "$nt_env" = prod ]; then assert_tag_branch x.y.z; else assert_tag_branch x.y.z-rc.1; fi
  kv head "$(git rev-parse --short HEAD)"
  nt_open=$(open_rc_base)
  if [ -n "$nt_open" ]; then
    nt_n=$(max_rc_n "$nt_open")
    if [ "$nt_env" = test ]; then
      kv tag "$nt_open-rc.$((nt_n + 1))"
    else
      kv tag "$nt_open"
      kv rc_open yes
      kv commits_since_rc "$(git rev-list --count "$nt_open-rc.$nt_n..HEAD")"
    fi
    return 0
  fi
  [ -n "$nt_type" ] || die "falta el tipo (patch|minor|major)"
  nt_base=$(semver_bump "$(last_final)" "$nt_type") || exit 1
  if [ "$nt_env" = test ]; then
    kv tag "$nt_base-rc.1"
  else
    kv tag "$nt_base"
  fi
}

# Rama actual, o "(detached)" con HEAD desacoplado.
current_branch() {
  git symbolic-ref --short -q HEAD || printf '(detached)\n'
}

# Un tag final (x.y.z) solo sale de la rama principal; un RC (x.y.z-rc.n), de cualquier otra.
assert_tag_branch() {
  at_cur=$(current_branch)
  at_main=$(main_branch)
  case "$1" in
    *-rc.*) [ "$at_cur" != "$at_main" ] || die "un RC no sale de $at_main" ;;
    *) [ "$at_cur" = "$at_main" ] || die "deploy a prod solo desde $at_main; estás en $at_cur" ;;
  esac
}

# context: estado que necesitan las skills para decidir.
cmd_context() {
  cx_lang=$(detect_lang) || exit 1
  cx_version=$(get_version) || exit 1
  cx_final=$(last_final)
  [ "$cx_final" = "0.0.0" ] && cx_final=none
  cx_open=$(open_rc_base)
  kv branch "$(current_branch)"
  kv develop_branch "$(develop_branch)"
  kv main_branch "$(main_branch)"
  kv lang "$cx_lang"
  kv version "$cx_version"
  kv chart_dir "$(chart_dir)"
  kv last_final "$cx_final"
  kv open_rc "${cx_open:-none}"
}

# Origin de git como "host<TAB>ruta<TAB>puerto-web" (puerto solo si es https/http); vacío si no es remoto con host.
origin_parts() {
  op_url=$(git remote get-url origin 2>/dev/null) || return 1
  op_url=${op_url%/}
  op_port=""
  case "$op_url" in
    https://* | http://* | ssh://* | git://*)
      op_scheme=${op_url%%://*}
      op_rest=${op_url#*://}
      op_host=${op_rest%%/*}
      op_path=${op_rest#*/}
      [ "$op_path" != "$op_rest" ] || return 1
      # El usuario se quita solo de la autoridad (antes de la primera /): la ruta puede tener @.
      op_host=${op_host##*@}
      case "$op_host" in
        *:*)
          case "$op_scheme" in https | http) op_port=${op_host#*:} ;; esac
          op_host=${op_host%%:*}
          ;;
      esac
      ;;
    *@*:*)
      op_rest=${op_url#*@}
      op_host=${op_rest%%:*}
      op_path=${op_rest#*:}
      op_path=${op_path#/}
      ;;
    *) return 1 ;;
  esac
  op_path=${op_path%.git}
  [ -n "$op_host" ] && [ -n "$op_path" ] || return 1
  printf '%s\t%s\t%s\n' "$op_host" "$op_path" "$op_port"
}

# Host del origin (sin usuario ni puerto); falla si el origin no es remoto con host.
origin_host() {
  oh=$(origin_parts) || return 1
  printf '%s\n' "${oh%%	*}"
}

# URL web del proyecto: https://<host>/<ruta>, sin .git; falla si el origin no es remoto con host.
origin_web() {
  ow=$(origin_parts) || return 1
  ow_host=${ow%%	*}
  ow_rest=${ow#*	}
  ow_path=${ow_rest%%	*}
  ow_port=${ow_rest#*	}
  printf 'https://%s%s/%s\n' "$ow_host" "${ow_port:+:$ow_port}" "$ow_path"
}

# La rama debe rastrear origin/<la misma rama>: es donde empuja tag-push.
require_origin_upstream() {
  ru_up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || die "la rama $1 no tiene upstream"
  [ "$ru_up" = "origin/$1" ] || die "la rama $1 rastrea $ru_up pero se empuja a origin/$1; configurá su upstream"
}

# check: validaciones comunes de deploy-test y deploy-prod (solo git local).
cmd_check() {
  ck_branch=$(git symbolic-ref --short -q HEAD) || die "HEAD desacoplado, pasate a una rama"
  require_origin_upstream "$ck_branch"
  [ -z "$(git status --porcelain --untracked-files=no)" ] || die "hay cambios sin commitear"
  # Sin -q: con -q git también calla el motivo de un rechazo (ej. "would clobber existing tag").
  ck_err=$(git fetch --tags origin 2>&1) || die "no se pudo consultar origin: $ck_err"
  ck_counts=$(git rev-list --left-right --count 'HEAD...@{u}')
  if [ "$ck_counts" != "$(printf '0\t0')" ]; then
    ck_ahead=${ck_counts%%[[:space:]]*}
    ck_behind=${ck_counts##*[[:space:]]}
    die "$ck_branch no coincide con su upstream (adelante $ck_ahead, atrás $ck_behind); hacé push o pull"
  fi
  if [ -z "$(git config user.name)" ] || [ -z "$(git config user.email)" ]; then
    die "identidad git no configurada (user.name y user.email)"
  fi
  kv check ok
}

# bump <patch|minor|major|x.y.z>: sube la versión de la app y alinea appVersion; no commitea.
cmd_bump() {
  bp_arg=${1:-}
  [ -n "$bp_arg" ] || die "uso: bump <patch|minor|major|x.y.z>"
  bp_branch=$(current_branch)
  bp_dev=$(develop_branch)
  [ "$bp_branch" = "$bp_dev" ] || die "estás en $bp_branch; el bump se hace en $bp_dev"
  bp_from=$(get_version) || exit 1
  one_line "$bp_arg" || die "versión inválida: contiene saltos de línea"
  if printf '%s\n' "$bp_arg" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-SNAPSHOT)?$'; then
    bp_to=$bp_arg
  else
    bp_to=$(semver_bump "$bp_from" "$bp_arg") || exit 1
  fi
  set_version "$bp_to"
  set_chart_app_version "$bp_to"
  kv from "$bp_from"
  kv to "$bp_to"
}

# release-prep [--apply]: informa si la versión tiene -SNAPSHOT; con --apply lo quita y commitea.
cmd_release_prep() {
  rp_v=$(get_version) || exit 1
  case "$rp_v" in
    *-SNAPSHOT) ;;
    *)
      kv snapshot no
      return 0
      ;;
  esac
  rp_rel=${rp_v%-SNAPSHOT}
  kv snapshot yes
  kv release "$rp_rel"
  if [ "${1:-}" = "--apply" ]; then
    [ "$(current_branch)" != "$(main_branch)" ] || die "en $(main_branch) no se commitea: quitá -SNAPSHOT en otra rama y mergealo por MR"
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "hay cambios sin commitear"
    set_version "$rp_rel"
    set_chart_app_version "$rp_rel"
    git commit -q -a -m "Release app $rp_rel" || die "no se pudo crear el commit de release"
    kv committed yes
  fi
}

# tag-push <tag>: crea el tag anotado y empuja rama y tag de forma atómica.
cmd_tag_push() {
  tp_tag=${1:-}
  [ -n "$tp_tag" ] || die "uso: tag-push <tag>"
  if ! one_line "$tp_tag" || ! printf '%s\n' "$tp_tag" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$'; then
    die "formato de tag inválido: $tp_tag"
  fi
  assert_tag_branch "$tp_tag"
  # El pipeline falla en un tag si la versión de la app tiene -SNAPSHOT (solo si el lenguaje es detectable).
  if tp_v=$(get_version 2>/dev/null); then
    case "$tp_v" in
      *-SNAPSHOT) die "la versión de la app es $tp_v: un tag requiere x.y.z (usá release-prep --apply)" ;;
    esac
  fi
  tp_branch=$(git symbolic-ref --short -q HEAD) || die "HEAD desacoplado, pasate a una rama"
  require_origin_upstream "$tp_branch"
  [ -z "$(git status --porcelain --untracked-files=no)" ] || die "hay cambios sin commitear"
  # Un tag final solo se empuja sobre lo que ya está en origin/<main> (llegó por MR): nunca commits locales.
  case "$tp_tag" in
    *-rc.*) ;;
    *)
      tp_err=$(git fetch --tags origin 2>&1) || die "no se pudo consultar origin: $tp_err"
      tp_counts=$(git rev-list --left-right --count "HEAD...origin/$tp_branch" 2>/dev/null) || die "no existe origin/$tp_branch"
      tp_ahead=${tp_counts%%[[:space:]]*}
      [ "$tp_ahead" = 0 ] || die "$tp_branch tiene commits sin integrar por MR"
      [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$tp_branch")" ] || die "$tp_branch no coincide con origin/$tp_branch; actualizala (release-target)"
      ;;
  esac
  if git rev-parse -q --verify "refs/tags/$tp_tag" >/dev/null || git ls-remote --exit-code --tags origin "$tp_tag" >/dev/null 2>&1; then
    die "el tag $tp_tag ya existe"
  fi
  git tag -a "$tp_tag" -m "$tp_tag" || die "no se pudo crear el tag $tp_tag"
  if ! git push --atomic origin "HEAD:refs/heads/$tp_branch" "refs/tags/$tp_tag"; then
    git tag -d "$tp_tag" >/dev/null
    die "el push falló; se eliminó el tag local $tp_tag"
  fi
  kv pushed "$tp_tag"
}

# push-branch: empuja la rama actual a origin/<rama> (sin force); nunca la principal.
cmd_push_branch() {
  pb_branch=$(git symbolic-ref --short -q HEAD) || die "HEAD desacoplado, pasate a una rama"
  [ "$pb_branch" != "$(main_branch)" ] || die "en $pb_branch no se empuja: llegá por MR"
  git push origin "HEAD:refs/heads/$pb_branch" || die "no se pudo empujar $pb_branch"
  kv pushed_branch "$pb_branch"
}

# gitlab-mode: `glab` si hay glab con sesión en el host del origin; si no, `manual`.
cmd_gitlab_mode() {
  gm_host=$(origin_host) || {
    kv gitlab manual
    return 0
  }
  if command -v glab >/dev/null 2>&1 && glab auth status --hostname "$gm_host" >/dev/null 2>&1; then
    kv gitlab glab
  else
    kv gitlab manual
  fi
}

# mr-link: URL para abrir a mano el MR <develop> → <main> en la web de GitLab.
cmd_mr_link() {
  ml_web=$(origin_web) || die "el origin no es un remoto con host: no se puede armar el link"
  kv mr_link "$ml_web/-/merge_requests/new?merge_request[source_branch]=$(develop_branch)&merge_request[target_branch]=$(main_branch)"
}

# Estado del pipeline de GitLab para el flujo: los intermedios se informan como `running`.
pipeline_state() {
  case "$1" in
    created | waiting_for_resource | preparing | pending | running | scheduled) printf 'running\n' ;;
    '' | null) printf 'none\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# mr-find: MR abierto <develop> → <main>.
cmd_mr_find() {
  mf_out=$(glab mr list -s "$(develop_branch)" -t "$(main_branch)" -F json 2>&1) || die "glab mr list falló: $mf_out"
  mf_iid=$(printf '%s\n' "$mf_out" | json_get 0.iid)
  if [ -z "$mf_iid" ] || [ "$mf_iid" = null ]; then
    kv mr none
    return 0
  fi
  kv mr_iid "$mf_iid"
  kv mr_url "$(printf '%s\n' "$mf_out" | json_get 0.web_url)"
}

# mr-create: crea el MR <develop> → <main> (merge commit, sin borrar la rama de desarrollo).
cmd_mr_create() {
  mc_dev=$(develop_branch)
  mc_main=$(main_branch)
  mc_out=$(glab mr create -s "$mc_dev" -b "$mc_main" -t "Release $mc_dev → $mc_main" -d "" --remove-source-branch=false --squash-before-merge=false --yes 2>&1) || die "glab mr create falló: $mc_out"
  mc_url=$(printf '%s\n' "$mc_out" | grep -Eo 'https?://[^[:space:]]+/-/merge_requests/[0-9]+' | tail -n 1)
  [ -n "$mc_url" ] || die "glab no devolvió la URL del MR: $mc_out"
  kv mr_iid "${mc_url##*/}"
  kv mr_url "$mc_url"
}

# El iid de un MR es un entero; el sha, hexadecimal de 7 a 40 caracteres.
require_iid() {
  case "$1" in '' | *[!0-9]*) die "iid inválido: $1" ;; esac
}

require_sha() {
  # Conjunto explícito: con el rango a-f, bash 3.2 en UTF-8 (macOS) también acepta mayúsculas.
  case "$1" in '' | *[!0123456789abcdef]*) die "sha inválido: $1" ;; esac
  [ "${#1}" -ge 7 ] && [ "${#1}" -le 40 ] || die "sha inválido: $1"
}

# mr_status <iid>: imprime state, pipeline, sha, url y remove_source del MR (los usan mr-status, mr-wait y mr-merge).
mr_status() {
  require_iid "$1"
  ms_out=$(glab mr view "$1" -F json 2>&1) || die "glab mr view falló: $ms_out"
  kv state "$(printf '%s\n' "$ms_out" | json_get state)"
  kv pipeline "$(pipeline_state "$(printf '%s\n' "$ms_out" | json_get head_pipeline.status)")"
  kv sha "$(printf '%s\n' "$ms_out" | json_get sha)"
  kv url "$(printf '%s\n' "$ms_out" | json_get web_url)"
  # 'Delete source branch' del MR: con true, mergear borraría la rama de desarrollo.
  if [ "$(printf '%s\n' "$ms_out" | json_get force_remove_source_branch)" = true ]; then
    kv remove_source true
  else
    kv remove_source false
  fi
}

cmd_mr_status() {
  [ -n "${1:-}" ] || die "uso: mr-status <iid>"
  mr_status "$1"
}

# mr-wait <iid> <pipeline|merged>: consulta cada CEPHAL_POLL_SECONDS hasta que se cumple la condicion
# (o el MR se cierra o mergea) o vence CEPHAL_WAIT_STEP_SECONDS.
cmd_mr_wait() {
  [ $# -ge 2 ] || die "uso: mr-wait <iid> <pipeline|merged>"
  mw_iid=$1
  mw_mode=$2
  case "$mw_mode" in
    pipeline | merged) ;;
    *) die "modo inválido: $mw_mode (usar pipeline o merged)" ;;
  esac
  mw_poll=${CEPHAL_POLL_SECONDS:-30}
  mw_step=${CEPHAL_WAIT_STEP_SECONDS:-100}
  case "$mw_poll" in '' | *[!0-9]*) die "CEPHAL_POLL_SECONDS debe ser un entero >= 0: $mw_poll" ;; esac
  case "$mw_step" in '' | *[!0-9]*) die "CEPHAL_WAIT_STEP_SECONDS debe ser un entero >= 0: $mw_step" ;; esac
  mw_start=$(date +%s 2>/dev/null)
  case "$mw_start" in '' | *[!0-9]*) die "no se pudo leer la hora del sistema" ;; esac
  while :; do
    mw_out=$(mr_status "$mw_iid") || exit 1
    mw_state=$(printf '%s\n' "$mw_out" | sed -n 's/^state=//p')
    mw_pipe=$(printf '%s\n' "$mw_out" | sed -n 's/^pipeline=//p')
    # Un MR cerrado o mergeado termina la espera en ambos modos; en pipeline, también cuando deja de correr.
    mw_done=no
    case "$mw_state" in merged | closed) mw_done=yes ;; esac
    if [ "$mw_mode" = pipeline ] && [ "$mw_pipe" != running ]; then mw_done=yes; fi
    if [ "$mw_done" = yes ]; then
      printf '%s\n' "$mw_out"
      kv timeout no
      return 0
    fi
    mw_now=$(date +%s 2>/dev/null)
    case "$mw_now" in '' | *[!0-9]*) die "no se pudo leer la hora del sistema" ;; esac
    if [ $((mw_now - mw_start)) -ge "$mw_step" ]; then
      printf '%s\n' "$mw_out"
      kv timeout yes
      return 0
    fi
    [ "$mw_poll" -gt 0 ] && sleep "$mw_poll"
  done
}

# mr-merge <iid> <sha>: merge con merge commit, solo si la cabeza del MR sigue siendo <sha>;
# nunca borra la rama de desarrollo (flag explícito y rechazo si el MR la borraría).
cmd_mr_merge() {
  [ $# -ge 2 ] || die "uso: mr-merge <iid> <sha>"
  require_iid "$1"
  require_sha "$2"
  mm_st=$(mr_status "$1") || exit 1
  # remove_source es la última línea de mr_status.
  [ "${mm_st##*remove_source=}" != true ] || die "el MR borraría $(develop_branch) al mergear: desactivá 'Delete source branch' en el MR"
  mm_out=$(glab mr merge "$1" --sha "$2" --remove-source-branch=false --auto-merge=false --yes 2>&1) || die "no se pudo mergear: $mm_out"
  kv merged yes
}

# release-target: deja el checkout en <main> actualizado con origin (fast-forward) tras integrar el MR.
cmd_release_target() {
  rt_dev=$(develop_branch)
  rt_main=$(main_branch)
  rt_err=$(git fetch --tags origin 2>&1) || die "no se pudo consultar origin: $rt_err"
  # Sin estas guardas, una rama mal configurada se leería como "falta integrar el MR".
  for rt_b in "$rt_dev" "$rt_main"; do
    git rev-parse -q --verify "refs/remotes/origin/$rt_b" >/dev/null || die "no existe origin/$rt_b; revisá DEVELOP_BRANCH/MAIN_BRANCH"
  done
  git merge-base --is-ancestor "origin/$rt_dev" "origin/$rt_main" 2>/dev/null || die "$rt_main no contiene $rt_dev: falta integrar el MR"
  [ -z "$(git status --porcelain --untracked-files=no)" ] || die "hay cambios sin commitear"
  if git rev-parse -q --verify "refs/heads/$rt_main" >/dev/null; then
    rt_err=$(git checkout "$rt_main" 2>&1) || die "no se pudo pasar a $rt_main: $rt_err"
  else
    rt_err=$(git checkout -b "$rt_main" --track "origin/$rt_main" 2>&1) || die "no se pudo crear $rt_main desde origin/$rt_main: $rt_err"
  fi
  # El fetch ya corrió: alcanza con un fast-forward a origin/<main> (no depende del upstream de la rama).
  rt_err=$(git merge --ff-only "origin/$rt_main" 2>&1) || die "el checkout quedó en $rt_main; no se pudo actualizar $rt_main con origin/$rt_main (¿divergió?): $rt_err"
  [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$rt_main")" ] || die "$rt_main tiene commits locales sin pushear; no coincide con origin/$rt_main (el checkout quedó en $rt_main)"
  # Una main creada a mano puede no rastrear origin; tag-push lo exige al final del flujo.
  if ! git rev-parse --abbrev-ref --symbolic-full-name "$rt_main@{u}" >/dev/null 2>&1; then
    rt_err=$(git branch --set-upstream-to="origin/$rt_main" "$rt_main" 2>&1) || die "no se pudo configurar el upstream de $rt_main: $rt_err"
    kv upstream "origin/$rt_main"
  fi
  kv branch "$rt_main"
  kv head "$(git rev-parse --short HEAD)"
  rt_tag=$(git tag --points-at HEAD | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | max_semver)
  if [ -n "$rt_tag" ]; then kv tagged "$rt_tag"; fi
}

main() {
  LANG_OVERRIDE=""
  if [ "${1:-}" = "--lang" ]; then
    [ $# -ge 2 ] || die "falta el valor de --lang"
    LANG_OVERRIDE=$2
    shift 2
  fi
  [ $# -ge 1 ] || die "uso: cephal-version [--lang L] <context|check|bump|release-prep|next-tag|tag-push|push-branch|gitlab-mode|mr-link|mr-find|mr-create|mr-status|mr-wait|mr-merge|release-target>"
  sub=$1
  shift
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "no es un repositorio git"
  cd "$top" || die "no se pudo entrar a $top"
  fn="cmd_$(printf '%s' "$sub" | tr '-' '_')"
  if type "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  else
    die "subcomando desconocido: $sub"
  fi
}

[ "${CEPHAL_VERSION_SOURCED:-}" = 1 ] || main "$@"
